<!doctype html>

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">

    {%- render 'seo-head' -%}

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}
      Fonts are served from this theme's own assets, so the only origin on the critical path is
      Shopify's CDN. The Google Fonts <link> that used to sit here cost a DNS + TLS handshake to
      fonts.googleapis.com, then a second one to fonts.gstatic.com, before any body text painted.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'wixmadefortext-latin-normal.woff2' | asset_url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'Bembo.woff2' | asset_url }}">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    {%- comment -%}
      Stylesheets, all same-origin now. tiny-slider, AOS and Swiper used to come from cdnjs,
      unpkg and jsDelivr - three extra origins on the critical path, and the unpkg URLs answered
      with a 302 before serving anything.
    {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'theme.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'komradd.css' | asset_url }}">

    {{- 'theme.css' | asset_url | stylesheet_tag -}}
    {{- 'komradd.css' | asset_url | stylesheet_tag -}}
    {{- 'michaelcustom.css' | asset_url | stylesheet_tag -}}
    {{- 'tiny-slider.min.css' | asset_url | stylesheet_tag -}}
    {{- 'aos.css' | asset_url | stylesheet_tag -}}

    {%- if request.page_type == 'gift_card' -%}
      <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script async src="{{ 'es-module-shims.min.js' | asset_url }}"></script>

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {%- if request.page_type == 'product' -%}
      {% style %}
        .timesact-preorder-description::after {
          content: " {{ product.metafields.custom.bespoke_lead_time }}.";
        }
      {% endstyle %}
    {%- endif -%}

    {%- comment -%}Redirect products priced at $0 to the catalogue.{%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      {%- assign current_variant = product.selected_or_first_available_variant -%}

      {%- if current_variant.price == 0 -%}
        {%- unless request.design_mode -%}
          <script>
            window.location.replace("/collections/all-products");
          </script>
          <style>
            /* Hide the body briefly so the product does not flash before the redirect. */
            body { opacity: 0; pointer-events: none; }
          </style>
        {%- endunless -%}
      {%- endif -%}
    {%- endif -%}
  </head>

  {% liquid
    assign features_class = ''

    if settings.show_button_transition
      assign features_class = features_class | append: 'features--button-transition '
    endif

    if settings.show_image_zoom_on_hover
      assign features_class = features_class | append: 'features--zoom-image '
    endif

    if settings.show_page_transition
      assign features_class = features_class | append: 'features--page-transition '
    endif
  %}

  <body class="body-class {{ features_class }}
    {% if template == "index" %}
      homepage
    {% elsif template == "collection" %}
      collection-page
    {% elsif template == "product" %}
      product-page
    {% endif %}
    ">

    {%- render 'shadow-dom-templates' -%}

    <loading-bar class="loading-bar" aria-hidden="true"></loading-bar>
    <a href="#main" allow-hash-change class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
    {%- endif -%}

    <main id="main" class="anchor">
      {{ content_for_layout }}
    </main>

    {%- if request.page_type != 'password' -%}
      {%- sections 'footer-group' -%}
    {%- endif -%}

    {%- comment -%}
      ------------------------------------------------------------------------------------------
      SCRIPTS

      Everything below used to be ~14 inline blocks, several of them sitting after </body> and
      inside </html>. Three of them threw on every page load, which silently killed the rest of
      their block. The logic now lives in custom.js, deferred, with the Liquid-dependent values
      handed over on window.themeCustom.
      ------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <script>
      window.themeCustom = {
        pageType: {{ request.page_type | json }},
        bespokeLeadTime: {{ product.metafields.custom.bespoke_lead_time | default: '' | json }},
        allowBackorder: {{ product.metafields.custom.allow_backorder | default: '' | json }}
        {%- if product -%}
          , productTitle: {{ product.title | json }}
          , productId: {{ product.id | json }}
          , productUrl: {{ product.url | prepend: request.origin | json }}
        {%- endif -%}
      };
    </script>

    {%- comment -%}
      `defer` preserves execution order, so jQuery is always ready before its plugins and before
      custom.js runs. tinyslidercustom.js supplies window.tns for the announcement bar.
    {%- endcomment -%}
    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'jquery.paroller.min.js' | asset_url }}" defer></script>
    <script src="{{ 'aos.js' | asset_url }}" defer></script>
    <script src="{{ 'tinyslidercustom.js' | asset_url }}" defer></script>
    <script src="{{ 'custom.js' | asset_url }}" defer></script>

    <script>
      window.addEventListener('load', function () {
        if (window.AOS) window.AOS.init();
      }, { once: true });
    </script>

    {%- comment -%}
      ------------------------------------------------------------------------------------------
      DEFERRED THIRD PARTIES

      Hotjar (session recording) and respond.io (chat widget) are needed neither to render the
      page nor to buy from it. Hotjar used to be the very first thing in <head>, above <meta
      charset>. They now load once the page is idle or on the first real interaction - whichever
      comes first - so they cost nothing on the measured load.
      ------------------------------------------------------------------------------------------
    {%- endcomment -%}
    <script>
      (function () {
        var loaded = false;

        function loadDeferredThirdParties() {
          if (loaded) return;
          loaded = true;

          /* Hotjar */
          (function (h, o, t, j, a, r) {
            h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments); };
            h._hjSettings = { hjid: 3802428, hjsv: 6 };
            a = o.getElementsByTagName('head')[0];
            r = o.createElement('script');
            r.async = 1;
            r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
            a.appendChild(r);
          })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');

          /* respond.io chat widget */
          var respond = document.createElement('script');
          respond.id = 'respondio__growth_tool';
          respond.async = true;
          respond.src = 'https://cdn.respond.io/widget/widget.js?wId=63db6fd2-9014-424c-a537-8eb0fc8ddda1';
          document.body.appendChild(respond);
        }

        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
          window.addEventListener(evt, loadDeferredThirdParties, { once: true, passive: true });
        });

        window.addEventListener('load', function () {
          if (window.requestIdleCallback) {
            window.requestIdleCallback(loadDeferredThirdParties, { timeout: 5000 });
          } else {
            setTimeout(loadDeferredThirdParties, 3000);
          }
        }, { once: true });
      })();
    </script>
  </body>
</html>
