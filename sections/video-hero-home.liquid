{% comment %} Custom CSS {% endcomment %}
{% style %}
  #custom-video-section_{{ section.id }}{
    height:100% !important;
  }
  #custom-video-section_{{ section.id }}.content-over-media>:not(img,video,iframe,svg,video-media,picture){
    max-width:100% !important;
    position: absolute !important;
    left: 0 !important;
  }

  {%if template == 'index' %}
  @media(width <= 768px){
    header {
      margin-top: 25px;
    }
  }
  {%endif %}

  .custom-video-text {
    display: none !important;
}
{% endstyle %}

{% if template == "index" %}
<div id="custom-video-section_{{ section.id }}" {% if section.settings.add-custom-attribute != blank %}{{section.settings.add-custom-attribute}}{% endif %} class="content-over-media content-over-media--{{ section.settings.video_size }}" style="{% render 'surface', text_color: section.settings.text_color %}">
  {%- assign poster_image = section.settings.poster | default: section.settings.video.preview_image -%}

  {%- liquid
    assign hero_desktop = section.settings.poster
    assign hero_mobile = section.settings.poster-mobile | default: section.settings.poster
    assign hero_alt = section.settings.poster_alt

    if hero_alt == blank
      assign hero_alt = section.settings.poster.alt
    endif

    if hero_alt == blank
      assign hero_alt = shop.name
    endif
  -%}

  {%- capture poster -%}
    {%- unless section.settings.autoplay -%}
      {%- if poster_image != blank -%}
        {{- poster_image | image_url: width: poster_image.width | image_tag: loading: 'lazy', sizes: '100vw', widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' -}}
      {%- else -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full placeholder placeholder--invert' | replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"' -}}
      {%- endif -%}
    {%- endunless -%}
  {%- endcapture -%}

  {%- if section.settings.video -%}
    <video-media id="hero-video" {% if section.settings.autoplay %}autoplay{% endif %} style="--aspect-ratio: {{ section.settings.video.aspect_ratio }}">
      {{- poster -}}
      {{- section.settings.video | video_tag: class: 'object-cover', controls: section.settings.show_controls, playsinline: true, muted: "muted", loop: "loop", preload: 'none', image_size: '400x' -}}
    </video-media>

    {% if section.settings.video-mobile != blank %}
      <video-media id="hero-video-mobile" {% if section.settings.autoplay %}autoplay{% endif %} style="--aspect-ratio: {{ section.settings.video.aspect_ratio }}">
        {{- poster -}}
        {{- section.settings.video-mobile | video_tag: class: 'object-cover', controls: section.settings.show_controls, playsinline: true, muted: "muted", loop: "loop", preload: 'none', image_size: '400x' -}}
      </video-media>
    {% endif %}

    {% if section.settings.poster-mobile != blank %}
      {{- section.settings.poster-mobile
        | image_url: width: 1100
        | image_tag:
            class: 'show-mobile-hero',
            alt: hero_alt,
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            sizes: '100vw',
            widths: '480,600,750,900,1100,1500'
      -}}
    {% endif %}
  {%- else -%}
    {%- comment -%}
      LCP hero. Previously this rendered TWO full-size <img> tags (a 3000x3000 desktop PNG and a
      1000x1000 mobile PNG) and hid one with CSS - so the browser downloaded both, ~6.2MB total.
      A <picture> with media queries fetches exactly one, at a sensible width, as WebP.
      `.content-over-media > picture { display: contents }` (theme.css) means the layout is unchanged.
    {%- endcomment -%}
    {%- if hero_desktop != blank -%}
      {%- if hero_mobile != blank -%}
        <link rel="preload" as="image" fetchpriority="high" media="(max-width: 749px)"
          imagesizes="100vw"
          imagesrcset="{{ hero_mobile | image_url: width: 480 }} 480w, {{ hero_mobile | image_url: width: 750 }} 750w, {{ hero_mobile | image_url: width: 1100 }} 1100w, {{ hero_mobile | image_url: width: 1500 }} 1500w">
      {%- endif -%}
      <link rel="preload" as="image" fetchpriority="high" media="(min-width: 750px)"
        imagesizes="100vw"
        imagesrcset="{{ hero_desktop | image_url: width: 900 }} 900w, {{ hero_desktop | image_url: width: 1200 }} 1200w, {{ hero_desktop | image_url: width: 1600 }} 1600w, {{ hero_desktop | image_url: width: 2000 }} 2000w">

      <picture>
        {%- if hero_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            sizes="100vw"
            width="{{ hero_mobile.width }}"
            height="{{ hero_mobile.height }}"
            srcset="{{ hero_mobile | image_url: width: 480 }} 480w, {{ hero_mobile | image_url: width: 750 }} 750w, {{ hero_mobile | image_url: width: 1100 }} 1100w, {{ hero_mobile | image_url: width: 1500 }} 1500w">
        {%- endif -%}
        <source
          media="(min-width: 750px)"
          sizes="100vw"
          width="{{ hero_desktop.width }}"
          height="{{ hero_desktop.height }}"
          srcset="{{ hero_desktop | image_url: width: 900 }} 900w, {{ hero_desktop | image_url: width: 1200 }} 1200w, {{ hero_desktop | image_url: width: 1600 }} 1600w, {{ hero_desktop | image_url: width: 2000 }} 2000w">
        <img
          class="hero-image-novideo"
          src="{{ hero_desktop | image_url: width: 1600 }}"
          alt="{{ hero_alt | escape }}"
          width="{{ hero_desktop.width }}"
          height="{{ hero_desktop.height }}"
          fetchpriority="high"
          loading="eager"
          decoding="async">
      </picture>
    {%- endif -%}
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="place-self-center text-center">
      <div class="prose">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {% when 'liquid' %}
              {{ block.settings.liquid }}

            {%- when 'play' -%}
              {%- unless section.settings.autoplay -%}
                <button class="play-button" type="button" {{ block.shopify_attributes }}>
                  <span class="sr-only">{{ 'general.accessibility.play_video' | t }}</span>

                  <svg fill="none" width="48" height="48" viewBox="0 0 48 48">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M48 24c0 13.255-10.745 24-24 24S0 37.255 0 24 10.745 0 24 0s24 10.745 24 24Zm-18 0-9-6.6v13.2l9-6.6Z" fill="{{ block.settings.icon_color }}"/>
                  </svg>
                </button>
              {%- endunless -%}

            {%- when 'subheading' -%}
              {% style %}
                .subheading_{{block.id }}{
                  font-size:{{  block.settings.text_size | append:"px !important"}};
                  color:{{ block.settings.text_color | append:" !important" }};
                  {% if block.settings.show_bg %}
                  background:{{ block.settings.background_color }};
                  padding:10px;
                  {% endif %}
                  text-align:{{ block.settings.text_align | append:" !important" }};
                }
                @media(width <= 768px){
                  .subheading_{{block.id }}{
                    font-size:20px !important;
                  }
                }
              {% endstyle %}
              {%- if block.settings.text != blank -%}
                <p class="h6 subheading_{{block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}

            {%- when 'heading' -%}
              {% style %}
                .heading_{{ block.id }}{
                  font-size:{{  block.settings.text_size | append:"px !important"}};
                  color:{{ block.settings.text_color | append:" !important" }};
                  text-align:{{ block.settings.text_align | append:" !important" }};
                  line-height: 1 !important;
                }
                @media(width <= 768px){
                  .heading_{{ block.id }}{
                    font-size:40px !important;
                  }
                }
              {% endstyle %}
              {%- liquid
                comment
                  Emit the real heading element the merchant picked, not a <p> wearing its class.
                  The visual class is kept identical so nothing moves. On the homepage the header
                  logo is already the <h1>, so an h1 here is demoted to h2 to avoid two h1s.
                endcomment
                assign hero_heading_tag = block.settings.heading_tag

                if hero_heading_tag == 'h1' and request.page_type == 'index'
                  assign hero_heading_tag = 'h2'
                endif
              -%}
              {%- if block.settings.text != blank -%}
                <{{ hero_heading_tag }} class="{{ block.settings.heading_tag }} heading_{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</{{ hero_heading_tag }}>
              {%- endif -%}

            {%- when 'richtext' -%}
              {%- if block.settings.content != blank -%}
                <div {{ block.shopify_attributes }}>
                  {{- block.settings.content -}}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% endif %}



{% schema %}
{
  "name": "Video Hero Home",
  "class": "shopify-section--video",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "add-custom-attribute",
      "label": "Add Custom Attribute for animation"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.info"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:global.video.autoplay",
      "info": "t:global.video.autoplay_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "t:global.video.show_controls",
      "default": true
    },
    {
      "type": "select",
      "id": "video_size",
      "label": "t:global.video.video_size",
      "info": "t:global.video.ratio_avoid_cropping_info",
      "options": [
        {
          "value": "auto",
          "label": "t:global.sizes.original_video_ratio"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "fill",
          "label": "t:global.sizes.fit_screen"
        }
      ],
      "default": "md"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:global.video.video",
      "info": "t:global.video.video_info"
    },
    {
      "type": "video",
      "id": "video-mobile",
      "label": "Mobile video"
    },
    {
      "type": "video_url",
      "id": "external_video_url",
      "accept": ["vimeo", "youtube"],
      "label": "t:global.video.video_url",
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:sections.video.poster_image",
      "info": "t:sections.video.poster_image_info"
    },
    {
      "type": "image_picker",
      "id": "poster-mobile",
      "label": "Poster Mobile"
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Hero image alt text",
      "info": "Describes the hero image for search engines and screen readers. Falls back to the image's own alt text, then the shop name."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:global.colors.text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "liquid",
      "name": "Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "liquid",
          "label": "Liquid"
        }
      ]
    },
    {
      "type": "play",
      "name": "t:sections.video.blocks.play_button.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.video.blocks.play_button.info"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "t:global.colors.button_background",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "t:sections.video.blocks.subheading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:global.text.text",
          "default": "Subheading"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            {
              "label": "Left",
              "value": "left"
            },
            {
              "label": "Center",
              "value": "center"
            },
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Text size",
          "unit": "px",
          "min": 10,
          "max": 50,
          "step": 1,
          "default": 25
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        },
        {
          "type": "checkbox",
          "id": "show_bg",
          "label": "Show background",
          "default": false
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Bakground color",
          "visible_if": "{{ block.settings.show_bg == true }}"
        },
        
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.video.blocks.heading.name",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "t:global.text.text",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:global.text.style",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            {
              "label": "Left",
              "value": "left"
            },
            {
              "label": "Center",
              "value": "center"
            },
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Text size",
          "unit": "px",
          "min": 10,
          "max": 200,
          "step": 5,
          "default": 50
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        },
      ]
    },
    {
      "type": "richtext",
      "name": "t:sections.video.blocks.paragraph.name",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use video to showcase product features or to create a unique atmosphere on your store.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.video.name",
      "blocks": [
        {
          "type": "play"
        },
        {
          "type": "heading",
          "settings": {
            "text": "Video"
          }
        }
      ]
    }
  ]
}
{% endschema %}


