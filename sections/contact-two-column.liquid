{{ 'contact-two-col.css' | asset_url | stylesheet_tag }}
<div {% if section.settings.add-custom-attribute != blank %}{{section.settings.add-custom-attribute}}{% endif %} class="{% if section.settings.add-class-parent != blank %}{{ section.settings.add-class-parent }}{% endif %} container">
<div class="section-spacing--padded">
  <h2>{{ section.settings.heading }}</h2>
  <div class="two-col-contact-wrap">
  
    <div class="two-col-icons">
      <div class="icon-wrap-custom-contact">
        {% if section.settings.text1 != blank %}
          {%- render 'icon' with section.settings.icon1 -%}
          <p class="h4"><a href="{{ section.settings.url1 }}">{{ section.settings.text1 }}</a></p>
        {% endif %}
      </div>
      <div class="icon-wrap-custom-contact">
        {% if section.settings.text2 != blank %}
          {%- render 'icon' with section.settings.icon2 -%}
          <p class="h4"><a href="{{ section.settings.url2 }}">{{ section.settings.text2 }}</a></p>
        {% endif %}
      </div>
      <div class="icon-wrap-custom-contact">
        {% if section.settings.text3 != blank %}
          {%- render 'icon' with section.settings.icon3 -%}
          <p class="h4"><a href="{{ section.settings.url3 }}">{{ section.settings.text3 }}</a></p>
        {% endif %}
      </div>
      <div class="icon-wrap-custom-contact">
        {% if section.settings.text4 != blank %}
          {%- render 'icon' with section.settings.icon4 -%}
          <p class="h4"><a href="{{ section.settings.url4 }}">{{ section.settings.text4 }}</a></p>
        {% endif %}
      </div>
    </div>

    <div class="text-wrap-custom-contact">
      <div class="text-inside">
        {{ section.settings.text-right }}
      </div>
    </div>
    
  </div>
</div>
</div>



