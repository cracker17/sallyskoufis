{%- style -%}
  .section-{{ section.id }} {
    position:fixed;
    top:0;
    z-index:7;
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.top_padding | append: 'px' }};
    padding-bottom: {{ section.settings.bottom_padding | append: 'px' }};
    cursor: pointer;
    color: {{ section.settings.text_color }};
    width:100%;
  }
  .section-{{ section.id }} .inner-con {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 650px;
    margin:auto;
  }
  .section-{{ section.id }} .swiper-slide {
    display: none; /* Hidden by default, shown by JS after geo-check */
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .section-{{ section.id }} .swiper-slide img,
  .section-{{ section.id }} .swiper-slide svg {
    height: {{ section.settings.icon_size | append: 'px' }};
    width: auto;
  }
  .section-{{ section.id }} .swiper-slide span {
    font-size: {{ section.settings.text_size | append: 'px' }};
    line-height: 100%;
    text-align:center;
    text-transform:uppercase;
  }
  .section-{{ section.id }} .slider-nav {
    display:none;
  }
  /* With fewer than two slides the bar is just a line of text, so Swiper is never loaded.
     These two rules stand in for the layout its stylesheet would have provided. */
  .section-{{ section.id }} .swiper.is-static {
    flex: 1;
  }
  .section-{{ section.id }} .swiper.is-static .swiper-wrapper {
    display: flex;
    justify-content: center;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="inner-con page-width">
    <div class="slider-nav prev">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
    </div>
    <div id="{{ section.id }}" class="swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" data-geo="{{ block.settings.limit_to_country }}">
            {%- if block.settings.icon -%}
              {{ block.settings.icon | image_url: width: '12', height: '12' | image_tag }}
            {%- endif -%}
            <span>{{ block.settings.announcement_text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="slider-nav next">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
    </div>
  </div>
</div>

{%- comment -%}
  ------------------------------------------------------------------------------------------------
  Swiper is now loaded ON DEMAND.

  Measured on the live storefront: 151KB of JavaScript and 18KB of CSS were downloaded and parsed
  on every page to display a single, static line of text - after the geo filter only one slide
  survives, and the prev/next arrows are hidden by CSS anyway. A carousel of one is not a carousel.

  The library is now fetched only when two or more slides actually survive the filter. The geo
  lookup is cached for the session and given a short timeout, so it no longer holds the bar up on
  every single page view.
  ------------------------------------------------------------------------------------------------
{%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    var container = section.querySelector('.swiper');
    var slides = Array.prototype.slice.call(section.querySelectorAll('.swiper-slide'));
    if (!container || !slides.length) return;

    var GEO_KEY = 'ss-announcement-country';

    function readCachedCountry() {
      try { return window.sessionStorage.getItem(GEO_KEY); } catch (e) { return null; }
    }

    function cacheCountry(value) {
      try { window.sessionStorage.setItem(GEO_KEY, value); } catch (e) { /* private mode */ }
    }

    function resolveCountry() {
      var cached = readCachedCountry();
      if (cached) return Promise.resolve(cached);

      /* Never let a third-party lookup hold the announcement bar hostage. */
      var timeout = new Promise(function (resolve) { setTimeout(function () { resolve('ALL'); }, 1500); });
      var lookup = fetch('https://ipapi.co/json/')
        .then(function (r) { return r.json(); })
        .then(function (d) { return (d && d.country_code) || 'ALL'; })
        .catch(function () { return 'ALL'; });

      return Promise.race([lookup, timeout]).then(function (country) {
        cacheCountry(country);
        return country;
      });
    }

    function applyGeo(country) {
      var active = 0;

      slides.forEach(function (slide) {
        var limit = slide.getAttribute('data-geo');
        var show = limit === 'ALL' ||
                   (limit === 'US' && country === 'US') ||
                   (limit === 'WW' && country !== 'US');

        if (show) { slide.style.display = 'flex'; active++; } else { slide.remove(); }
      });

      return active;
    }

    function loadAsset(tag, attrs) {
      return new Promise(function (resolve, reject) {
        var el = document.createElement(tag);
        Object.keys(attrs).forEach(function (k) { el.setAttribute(k, attrs[k]); });
        el.onload = resolve;
        el.onerror = reject;
        document.head.appendChild(el);
      });
    }

    function loadSwiper() {
      if (window.Swiper) return Promise.resolve();
      return Promise.all([
        loadAsset('link', { rel: 'stylesheet', href: {{ 'swiper-bundle.min.css' | asset_url | json }} }),
        loadAsset('script', { src: {{ 'swiper-bundle.min.js' | asset_url | json }} })
      ]);
    }

    function initSwiper(activeSlides) {
      if (typeof Swiper !== 'function') return;

      new Swiper('#{{ section.id }}', {
        slidesPerView: 1,
        spaceBetween: {{ section.settings.slides_gap }},
        loop: {{ section.settings.infinite_loop }},
        {%- if section.settings.auto_slide -%}
          autoplay: {
            delay: {{ section.settings.slide_speed | times: 1000 }},
            disableOnInteraction: {{ section.settings.pause_on_hover }}
          },
        {%- endif -%}
        breakpoints: {
          768: { slidesPerView: (activeSlides > 1 ? 2 : 1), spaceBetween: 40 },
          1024: {
            slidesPerView: (activeSlides > {{ section.settings.slides_per_view }} ? {{ section.settings.slides_per_view }} : activeSlides),
            spaceBetween: {{ section.settings.slides_gap }}
          }
        },
        navigation: {
          nextEl: '.section-{{ section.id }} .slider-nav.next',
          prevEl: '.section-{{ section.id }} .slider-nav.prev'
        }
      });
    }

    resolveCountry().then(function (country) {
      var activeSlides = applyGeo(country);

      if (activeSlides < 2) {
        /* Nothing to rotate - render as static text and skip the 169KB library entirely. */
        container.classList.add('is-static');
        return;
      }

      loadSwiper().then(function () { initSwiper(activeSlides); }).catch(function () {
        container.classList.add('is-static');
      });
    });
  });
</script>

{% schema %}
  {
    "name": "CWS Announcement",
    "settings": [
      { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
      { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
      { "type": "range", "id": "icon_size", "label": "Icon size", "default": 12, "min": 0, "max": 100, "step": 1, "unit": "px" },
      { "type": "range", "id": "text_size", "label": "Text size", "default": 13, "min": 0, "max": 100, "step": 1, "unit": "px" },
      { "type": "range", "id": "top_padding", "label": "Top padding", "default": 20, "min": 0, "max": 100, "step": 1, "unit": "px" },
      { "type": "range", "id": "bottom_padding", "label": "Bottom padding", "default": 20, "min": 0, "max": 100, "step": 1, "unit": "px" },
      { "type": "header", "content": "Slider options" },
      { "type": "checkbox", "id": "auto_slide", "label": "Auto slide", "default": true },
      { "type": "range", "id": "slide_speed", "label": "Slide speed", "default": 2.5, "min": 1, "max": 10, "step": 0.1, "unit": "sec" },
      { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
      { "type": "checkbox", "id": "infinite_loop", "label": "Infinite loop", "default": true },
      { "type": "range", "id": "slides_per_view", "label": "Slides per view", "default": 3, "min": 1, "max": 30, "step": 1 },
      { "type": "range", "id": "slides_gap", "label": "Slides gap", "default": 3, "min": 0, "max": 100, "step": 1 }
    ],
    "blocks": [
      {
        "type": "announcement_block",
        "name": "Icon with text",
        "settings": [
          { "type": "image_picker", "id": "icon", "label": "Icon" },
          { "type": "inline_richtext", "id": "announcement_text", "label": "Announcement text", "default": "Lorem ipsum." },
          {
            "type": "select",
            "id": "limit_to_country",
            "label": "Show to:",
            "options": [
              { "value": "ALL", "label": "Everyone" },
              { "value": "US", "label": "USA Only" },
              { "value": "WW", "label": "Rest of World (No US)" }
            ],
            "default": "ALL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "CWS Announcement",
        "blocks": [
          { "type": "announcement_block" },
          { "type": "announcement_block" },
          { "type": "announcement_block" }
        ]
      }
    ]
  }
{% endschema %}