{%- comment -%}logo-slider-komradd.css was a 0-byte file; the request bought nothing.{%- endcomment -%}



<div class="container">
  
  {% if section.blocks.size > 0 %} 
  <h4 class="h4">{{ section.settings.heading }}</h4>
    <div class="logo-slider-komradd">
      {% for block in section.blocks %}
            <div>  
                {{- block.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', decoding: 'async', widths: '240,360,480', alt: block.settings.logo.alt | default: shop.name -}}
            </div>
      {% endfor %}
    </div>
  {% endif %}
  
</div>

{% schema %}
{
  "name": "Logo Slider Komradd",
  "class": "section logo-slider-komradd-outer",
  "settings": [
    {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading"
    }
 ],
  "max_blocks": 30,
   "blocks": [
        {
        "name": "Logo",
        "type": "logo",
        "settings": [
            {
              "type": "image_picker",
              "id": "logo",
              "label": "Logo"
            }
        ]
     }
   ],
  "presets": [{
    "name": "Logo Slider Komradd",
    "category": "Text"
  }]

}
{% endschema %}

<script>
  /* tinyslidercustom.js is deferred now, so it has not run yet while this inline script is
     being parsed. Deferred scripts all finish before DOMContentLoaded, so waiting for that
     event is what keeps `tns` defined here. */
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof tns !== 'function') return;


    document.querySelectorAll('.logo-slider-komradd').forEach(slider => {
        tns({
          container: slider,
          items: 4,
          loop: true,
          autoplay: true,
          autoplayButtonOutput: false,
          preventActionWhenRunning: true,
          mouseDrag: false,
          speed: 4000,
          controls: false,
          autoplayTimeout: 0000,
          responsive: {
            0: {
              items: 2,
              gutter: 20
            },
            900: {
              items: 3,
              gutter: 20
            },
            1200: {
              items: 4,
              gutter: 20
            },
            1300: {
              items: 5,
              gutter: 20
            }
          }
        });
      });
  });
</script>
