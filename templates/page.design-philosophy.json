        "template--21385295626531__e2e4e2b6-54b6-4d3b-981f-b1a0bba0d055-richtext-1": {
          "type": "richtext",
          "settings": {
            "content": "<h3><em>We’re all responsible for our purchase decisions. The movement I seek is for my clientele to know the real story emotionally and value that connection. In doing so, they become part of an exclusive yet inclusive group. Connecting to the moment jewelry was birthed, its impact, the memories it holds, the memories it will create, and the transformation it inspires.<\/em><\/h3>"
          }
        }
