    "8469231d-1e71-437b-b6f7-88ca9c80f65e": {
      "type": "image-with-text-block",
      "blocks": {
        "template--21385295626531__8469231d-1e71-437b-b6f7-88ca9c80f65e-richtext-1": {
          "type": "richtext",
          "settings": {
            "content": "<h3><em>Excellence For Creation<\/em><\/h3><h1>AT THE STUDIO<\/h1><p>Blending the old world with the new, each piece is produced by highly skilled craftsmen and women in Thailand, the birthplace of stone setting artistry dating 400BC.<\/p>"
          }
        }
      },
      "block_order": [
