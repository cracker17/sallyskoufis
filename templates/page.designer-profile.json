        "template--21436916203811__47b192e3-b39b-4210-854e-9e558b8f8a65-richtext-1": {
          "type": "richtext",
          "settings": {
            "content": "<h3><em>The Artist<\/em><\/h3><h1>SALLY SKOUFIS<\/h1><p>SALLY IS DRIVEN BY A PURPOSE OF HONOUR – FOR THE COLLECTIVE FOR WHICH HER ART IS CREATED, AND THE EARTH UPON WHICH WE WALK.<\/p>"
          }
        }
      },
      "block_order": [
        "template--21436916203811__47b192e3-b39b-4210-854e-9e558b8f8a65-richtext-1"
      ],
      "custom_css": [
