        "image_size": "auto",
        "image": "shopify:\/\/shop_images\/SALLY-SKOUFIS-JEWELRY-DESIGNER-PROFILE_1.jpg",
        "allow_transparent_header": false,
        "reveal_on_scroll": true,
        "remove_vertical_spacing": true,
        "content_width": "sm",
        "mobile_text_position": "place-self-end text-end",
