        "template--21436916203811__c4e61554-1253-4863-8f2d-358473a74e41-heading-1": {
          "type": "heading",
          "settings": {
            "text": "I’m incredibly honored to align my craft with human and environmental impact, to connect with a conscious collective globally, and translate an unwavering desire to pioneer and create change in how jewelry is experienced, valued and represented.",
