    <h2 class="h2">Delivery</h2>
    <div class="prose">
      {%- for block in filtered_blocks -%}
        {%- capture block_content_delivery -%}
          {%- case block.type -%}
            {%- when 'product-popups' -%}
                {% if block.settings.cstm-delivery != blank %}
                  {{ block.settings.cstm-delivery }}
                {% endif %}
          {%- endcase -%}
       {%- endcapture -%}
       {{- block_content_delivery -}}
    {% endfor %}
    </div>
  </div>



  <div id="custom-concierge-wrapper" class="custom-popups-wrapper">
    <span class="close-button" id="close-button-concierge">X</span>
    <h2 class="h2">At your service</h2>
    <div class="prose">
      {%- for block in filtered_blocks -%}
        {%- capture block_content_concierge -%}
          {%- case block.type -%}
            {%- when 'product-popups' -%}
                {% if block.settings.cstm-email != blank or block.settings.cstm-phone != blank or block.settings.cstm-hours != blank %}
                  <p class="with-svg">{%- render 'icon' with 'email' -%}{{ block.settings.cstm-email }}</p>
                  <p class="with-svg">{%- render 'icon' with 'picto-phone' -%}{{ block.settings.cstm-phone }}</p>
